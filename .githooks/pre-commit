#!/bin/sh
# Pre-commit: reject unformatted Clojure. Fix with: cljfmt fix src test (from clojure/).
# Enable once per clone: git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)/clojure" || exit 1
if ! command -v cljfmt >/dev/null 2>&1; then
  echo "cljfmt not installed, skipping format check"
  exit 0
fi
exec cljfmt check src test
