{
  "name": "backend",
  "version": "0.1.1",
  "engines": {
    "node": "24.x"
  },
  "private": true,
  "scripts": {
    "prestart": "./node_modules/.bin/migrate",
    "start": "nodemon index.js",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "test": "NODE_ENV='test' npm run coverage",
    "test:simple": "NODE_ENV='test' node spec/run.js",
    "test:parallel": "NODE_ENV='test' MONGO_TEST_URL=mongodb://localhost/docue-test-$$ node spec/run.js",
    "coverage": "nyc node spec/run.js && nyc report --reporter=text-lcov | coveralls",
    "codecov": "nyc report --reporter=text-lcov > coverage.lcov && codecov",
    "update-role": "node scripts/update-user-role.js",
    "list-users": "node scripts/list-users.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "debug": "^4.4.3",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "migrate": "^0.2.4",
    "moment": "^2.31.0",
    "mongoose": "^8.24.5",
    "morgan": "^1.12.1",
    "nodemon": "^3.1.14",
    "underscore": "^1.13.8"
  },
  "devDependencies": {
    "coveralls": "^3.1.1",
    "dotenv": "^17.2.3",
    "jasmine": "^5.13.0",
    "nyc": "^17.1.0",
    "supertest": "^7.3.1"
  }
}
